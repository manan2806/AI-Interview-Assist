{
  "expo": {
    "name": "AI Interview Assist",
    "slug": "ai-interview-assist",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/ai-interview-assist-Icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiinterviewassist.app"
    },
    "android": {
      "package": "com.aiinterviewassist.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/ai-interview-assist-Icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6219e504-5218-486e-9912-97ca96f063ef"
      }
    },
    "owner": "myprojectservices-team"
  }
}