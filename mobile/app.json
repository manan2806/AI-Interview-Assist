{
  "expo": {
    "name": "AI Interview Assist",
    "slug": "ai-interview-assist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ai-interview-assist-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiinterviewassist.app"
    },
    "android": {
      "package": "com.aiinterviewassist.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/ai-interview-assist-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6219e504-5218-486e-9912-97ca96f063ef"
      }
    },
    "owner": "myprojectservices-team"
  }
}